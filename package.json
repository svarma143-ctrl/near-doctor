{
  "name": "near-doctor",
  "version": "0.1.0",
  "description": "Preflight checks and an evidence-backed friction log for NEAR developers and their coding agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "near-doctor": "bin/near-doctor.mjs"
  },
  "files": [
    "bin",
    "src",
    "rules",
    "docs/FRICTION_LOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svarma143-ctrl/near-doctor.git"
  },
  "homepage": "https://github.com/svarma143-ctrl/near-doctor#readme",
  "bugs": {
    "url": "https://github.com/svarma143-ctrl/near-doctor/issues"
  },
  "keywords": [
    "near",
    "doctor",
    "preflight",
    "cargo-near",
    "developer-experience",
    "agents"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "node scripts/verify.mjs",
    "test:slow": "NEAR_DOCTOR_SLOW=1 node --test test/slow.test.mjs",
    "doctor": "node bin/near-doctor.mjs",
    "log": "node scripts/gen-log.mjs",
    "log:check": "node scripts/gen-log.mjs --check",
    "prepublishOnly": "node --test"
  },
  "main": "src/index.mjs"
}
